{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sheetbend:config:2",
  "title": "Sheetbend configuration, version 2",
  "description": "Validate the JSON-compatible value obtained by parsing config.toml. Defaults are applied by Sheetbend after validation. Credential values must not appear in this document.",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "default_source": {
      "$ref": "#/$defs/name"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "protocol",
        "base_url",
        "default_model",
        "scope",
        "auth",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "protocol": {
          "const": "openai-compatible",
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s?#@]+$",
          "description": "Explicit Chat Completions API root, including /v1 when needed. No userinfo, query, or fragment; credentials belong in auth. Redirects are not followed."
        },
        "default_model": {
          "$ref": "#/$defs/nonempty"
        },
        "scope": {
          "enum": [
            "local",
            "institutional",
            "external"
          ]
        },
        "organization": {
          "$ref": "#/$defs/nonempty"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 30
        },
        "allow_insecure_http": {
          "type": "boolean",
          "default": false
        },
        "ca_bundle": {
          "type": "string",
          "minLength": 1,
          "description": "Optional CA bundle path. Relative paths resolve against the selected config file's directory, or the working directory for Registry.from_dict(). TLS verification cannot be disabled."
        },
        "rate_limit": {
          "$ref": "#/$defs/rate_limit",
          "default": {}
        },
        "models": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/nonempty"
          },
          "additionalProperties": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "institutional"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "organization"
            ]
          },
          "else": {
            "not": {
              "required": [
                "organization"
              ]
            }
          }
        }
      ]
    },
    "auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "none",
            "bearer-placeholder",
            "bearer",
            "header"
          ]
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "header": {
          "type": "string",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
          "description": "Custom credential header, for example api-key. Authorization is reserved for bearer authentication; transport/routing headers are forbidden.",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "header"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "bearer-placeholder"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "header"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "bearer"
            }
          },
          "required": [
            "env"
          ],
          "not": {
            "required": [
              "header"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "header"
            }
          },
          "required": [
            "env",
            "header"
          ]
        }
      ]
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Same-user, same-host limits shared by applications using the same canonical config path and source name. Rolling 60-second request starts and active response consumption; not cluster-wide or provider quotas."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": {
          "type": "boolean",
          "default": true
        },
        "json_schema": {
          "type": "boolean",
          "default": false
        },
        "vision": {
          "type": "boolean",
          "default": false
        },
        "tools": {
          "type": "boolean",
          "default": false
        },
        "system_prompt": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Declarations for this model as served by this source. Probes do not change them."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/capabilities",
          "default": {}
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning",
          "default": {}
        }
      }
    },
    "reasoning_choice": {
      "type": "string",
      "enum": [
        "provider",
        "off",
        "on",
        "low",
        "medium",
        "high"
      ],
      "description": "provider sends no Sheetbend reasoning control. Other choices must be explicitly supported by this model declaration. off never means low or hidden output."
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {
          "type": "string",
          "enum": [
            "unknown",
            "fixed-off",
            "fixed-on",
            "reasoning_effort",
            "chat_template_kwargs"
          ],
          "default": "unknown",
          "description": "unknown is undeclared, not non-reasoning. fixed-off/on describe fixed server behavior. reasoning_effort uses the declared values. chat_template_kwargs sends enable_thinking as a boolean."
        },
        "default": {
          "$ref": "#/$defs/reasoning_choice",
          "default": "provider"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "off": {
              "const": "none",
              "type": "string"
            },
            "on": {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "low": {
              "const": "low",
              "type": "string"
            },
            "medium": {
              "const": "medium",
              "type": "string"
            },
            "high": {
              "const": "high",
              "type": "string"
            }
          },
          "description": "Only for reasoning_effort. List choices the served model actually supports. on explicitly chooses an enabling effort; declare low/medium/high only for genuinely distinct effort levels."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "control": {
                "const": "reasoning_effort"
              }
            },
            "required": [
              "control"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ],
      "description": "Model/deployment-specific translation for portable reasoning requests. Defaults must resolve under this declaration. No name guessing, prompt rewriting, best-effort downgrade, or backend detection."
    }
  }
}
